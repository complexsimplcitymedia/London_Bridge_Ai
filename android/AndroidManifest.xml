<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.londonbridge.ai">

    <!-- Permissions for secure memory storage -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Service declaration for background memory persistence -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">
        
        <!-- Memory Persistence Service -->
        <service
            android:name="com.londonbridge.ai.memory.MemoryPersistenceService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE">
        </service>
        
    </application>

</manifest>
